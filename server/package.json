{
  "name": "uptimemonk-server",
  "version": "0.5.13",
  "private": true,
  "type": "module",
  "description": "UptimeMonk probe + API service for AWS Lightsail",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "tsc && node --eval \"fs.cpSync('src/db/migrations', 'dist/db/migrations', {recursive:true})\"",
    "typecheck": "tsc --noEmit",
    "test": "tsc && node --eval \"fs.cpSync('src/db/migrations', 'dist/db/migrations', {recursive:true})\" && node --test \"dist/**/*.test.js\"",
    "test:coverage": "tsc && node --eval \"fs.cpSync('src/db/migrations', 'dist/db/migrations', {recursive:true})\" && node --test --experimental-test-coverage \"dist/**/*.test.js\"",
    "worker": "node dist/worker.js",
    "api": "node dist/api.js",
    "dev:worker": "tsc && node dist/worker.js",
    "dev:api": "tsc && node dist/api.js"
  },
  "dependencies": {
    "@fastify/cors": "^10.0.1",
    "@fastify/rate-limit": "^10.2.1",
    "better-sqlite3": "^11.7.0",
    "fastify": "^5.2.1",
    "firebase-admin": "^13.0.2",
    "pino": "^9.6.0",
    "stripe": "^17.7.0",
    "undici": "^7.2.0"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.12",
    "@types/node": "^22.10.5",
    "typescript": "^5.7.3"
  }
}
