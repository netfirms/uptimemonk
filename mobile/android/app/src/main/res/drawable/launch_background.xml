<?xml version="1.0" encoding="utf-8"?>
<!--
  The launch window, painted before Flutter draws its first frame.

  This was @android:color/white, and values-night pointed at this same
  drawable — so the splash was white in both light and dark mode while the
  app itself is always dark. Every cold start flashed white.

  The app has no light theme, so this is unconditionally dark rather than
  having a -night variant: matching the system would still be wrong half the
  time.
-->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:drawable="@color/launch_background" />
</layer-list>
