# Copy to /etc/uptimemonk/env, chmod 600, owner root:root.
# systemd reads this; the service user never needs to.

GOOGLE_CLOUD_PROJECT=uptimemonk

# --- Worker identity -------------------------------------------------------
# A "worker" is one Lightsail instance. Scale out by running more of them.
#
# Ownership is decided locally from a stable hash of the organisation id, so
# workers need no coordination, no leases and no lock service. The catch is
# that every worker in a region MUST agree on UPTIMEMONK_WORKER_COUNT — if they
# disagree, some organisations get probed twice and others not at all.
#
# One worker in Singapore:   INDEX=0 COUNT=1
# Three workers in Singapore: INDEX=0,1,2 respectively, COUNT=3 on all three.
UPTIMEMONK_REGION=ap-southeast-1
UPTIMEMONK_WORKER_ID=sg-1
UPTIMEMONK_WORKER_INDEX=0
UPTIMEMONK_WORKER_COUNT=1
PORT=8080

# Optional version overrides (defaults to version in server/package.json)
# UPTIMEMONK_VERSION=0.1.0
# UPTIMEMONK_API_VERSION=0.1.0
# UPTIMEMONK_WORKER_VERSION=0.1.0

APP_URL=https://uptimemonke.com
API_URL=https://api.uptimemonke.com

# Probe tuning. Raise concurrency only alongside LimitNOFILE — and only if the
# instance has the RAM: 200 sockets is a 1 GB setting, 50 suits 512 MB.
PROBE_CONCURRENCY=50
SQLITE_CACHE_KB=4000
SQLITE_MMAP_BYTES=16777216
DB_FLUSH_MS=5000
MIRROR_FLUSH_MS=300000
RECONCILE_MS=900000
RETENTION_DAYS=35

# Secrets
# Email. Mailgun is used when MAILGUN_API_KEY is set, otherwise Resend — so
# swapping providers is an env change and a restart, not a deploy. At least one
# is required or no email alert can be delivered; /healthz says so at boot.
MAILGUN_API_KEY=
# The *sending* domain registered with Mailgun, usually a subdomain.
MAILGUN_DOMAIN=mg.uptimemonke.com
# https://api.eu.mailgun.net for an EU-region account.
MAILGUN_BASE_URL=https://api.mailgun.net
RESEND_API_KEY=
TELEGRAM_BOT_TOKEN=
# Donations. Both are required, or the routes refuse and the donate button is
# hidden. The webhook secret is the only thing distinguishing Stripe from
# anyone who knows the URL.
# reCAPTCHA v3. Inert until RECAPTCHA_SECRET is set, and it gates workspace
# creation rather than sign-in — see lib/recaptcha.ts for why that is the only
# place this server can enforce anything.
RECAPTCHA_SECRET=
# Google's suggested cut. Lower is more permissive.
RECAPTCHA_MIN_SCORE=0.5
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
# Must be on MAILGUN_DOMAIN. An address off it authenticates as a different
# domain, so SPF and DKIM do not cover it and DMARC-enforcing receivers bin the
# alert — mail silently in spam is the same failure as mail never sent.
ALERT_FROM_EMAIL=alerts@mg.uptimemonke.com

# Cross-region confirmation. Generate with: openssl rand -hex 32
# Both boxes must share the same VERIFY_SECRET; each points at the other.
VERIFY_SECRET=
VERIFY_PEER_URL=

# External dead-man's switch. MUST be a different provider than this product:
# a monitor that monitors itself proves nothing when the box is off.
UPTIMEMONK_HEARTBEAT_URL=
