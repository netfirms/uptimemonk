rules_version = '2';

// UptimeMonk security rules.
//
// Principle: the dashboard reads Firestore directly (fast, realtime, free of
// function invocations) but NEVER writes anything the checker owns. Tenancy is
// enforced from a custom claim set at signup, so no rule needs a lookup —
// lookups are billed reads and slow every request down.
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }
    function orgId() {
      return request.auth.token.orgId;
    }
    function inOrg(id) {
      return signedIn() && (
        orgId() == id ||
        (exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
         get(/databases/$(database)/documents/users/$(request.auth.uid)).data.orgId == id)
      );
    }
    function isOwner() {
      return signedIn() && (
        request.auth.token.role == 'owner' ||
        (exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
         get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'owner')
      );
    }
    match /users/{uid} {
      allow read: if signedIn() && request.auth.uid == uid;
      allow create, update: if signedIn() && request.auth.uid == uid;
      allow delete: if false;
    }

    match /orgs/{id} {
      allow read: if inOrg(id);
      allow create: if signedIn() && request.resource.data.ownerUid == request.auth.uid;
      allow update: if inOrg(id) && isOwner()
        && request.resource.data.diff(resource.data).affectedKeys()
             .hasOnly(['name']); // plan/billing fields are backend-only
      allow delete: if false;
    }

    match /monitors/{monitorId} {
      allow read: if inOrg(resource.data.orgId);
      // Monitor writes are backend-only, and this is a security boundary
      // rather than a style preference.
      //
      // `target` becomes an outbound request from inside our network, so it
      // must pass lib/targetGuard.ts — which resolves the hostname and checks
      // every returned address against the link-local range where BOTH the
      // AWS and GCP metadata services live. Rules cannot do a DNS resolution,
      // and they cannot count monitors to enforce a plan limit either.
      //
      // Allowing a client to write `target` here lets it point a probe at
      // 169.254.169.254 and read credentials back through keyword matching.
      // A type allow-list and a minimum interval do not close that.
      //
      // Everything goes through the worker API: POST/PATCH/DELETE /v1/monitors.
      allow create, update, delete: if false;

      // Check history no longer lives in Firestore at all — it is in SQLite on
      // the probe box, served through the API. Nothing may create it here.
      match /{sub=**} {
        allow read, write: if false;
      }
    }

    // The aggregated status mirror: one document per org, written by the box
    // roughly every five minutes and immediately on any state change. This is
    // what the dashboard subscribes to for live monitor state — per-check data
    // never leaves the probe box, which is what keeps writes inside the free
    // tier regardless of how many monitors an org has.
    match /orgStatus/{id} {
      allow read: if inOrg(id);
      allow write: if false; // the probe box owns every field
    }

    match /incidents/{id} {
      allow read: if inOrg(resource.data.orgId);
      // Users may acknowledge an incident, nothing more.
      allow update: if inOrg(resource.data.orgId)
        && request.resource.data.diff(resource.data).affectedKeys()
             .hasOnly(['acknowledgedBy']);
      allow create, delete: if false;
    }

    match /alertContacts/{id} {
      allow read: if inOrg(resource.data.orgId);
      allow create: if inOrg(request.resource.data.orgId)
        && request.resource.data.verified == false; // verification is backend-only
      // The verification token fields are as sensitive as `verified` itself:
      // a client that could write the hash could verify a contact it does not
      // control. sendContactVerification owns all of them.
      allow update: if inOrg(resource.data.orgId)
        && !request.resource.data.diff(resource.data).affectedKeys()
             .hasAny(['verified', 'verifiedAt', 'orgId',
                      'verificationTokenHash', 'verificationSentAt',
                      'verificationExpiresAt']);
      allow delete: if inOrg(resource.data.orgId);
    }

    match /statusPages/{id} {
      // Public status pages are read by the SSR renderer using the Admin SDK,
      // which bypasses rules, so clients only get their own org's pages here.
      allow read: if inOrg(resource.data.orgId);
      allow create: if inOrg(request.resource.data.orgId);
      allow update, delete: if inOrg(resource.data.orgId);
    }

    match /apiKeys/{id} {
      // The hash must never leave the backend.
      allow read: if false;
      allow write: if false;
    }

    match /notifications/{id} {
      allow read: if inOrg(resource.data.orgId);
      allow write: if false;
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
